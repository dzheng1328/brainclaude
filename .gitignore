.DS_Store

# raw/ is the inbox, not the project. wiki/ (our synthesis) and .manifest.json
# (sha256 pointer into raw/) are what git tracks; raw/'s own content-hash state
# is what the manifest is for, so duplicating it into git history is redundant.
# No backup implication is free here — raw/ has no copy outside this filesystem
# unless one is set up separately.
raw/

# Personal domain — kept locally in the vault (visible in Obsidian), NEVER committed/pushed.
# Dave's private second brain holds real personal info (travel, study-abroad logistics, etc.);
# it must not reach the git remote. git filters by path, not by the `domain:` frontmatter tag,
# so personal-domain pages get a dedicated gitignored home instead of the kind-based folders.
# raw/ (above) already covers personal raw snapshots; this covers the personal wiki layer.
wiki/personal/

# Obsidian: keep shared config (appearance, plugins, graph settings),
# ignore per-machine UI state that churns on every pane you open.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# machine-local permission grants, not shared project config
.claude/settings.local.json

# graphify's extraction cache/output — regenerable tool state, not vault content
# (same treatment as raw/: large, derived, no reason to duplicate into git history).
# The published outputs worth keeping (GRAPH_REPORT.md, graph.html) can be committed
# individually if/when they're wanted, but not the intermediate chunk/cache JSON.
wiki/graphify-out/
